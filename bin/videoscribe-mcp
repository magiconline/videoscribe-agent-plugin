#!/bin/sh
set -eu
plugin_dir=$(CDPATH= cd -- "${0%/*}/.." && pwd)
app_path=${VIDEOSCRIBE_APP_PATH:-}
if [ -z "$app_path" ]; then
  if [ -n "${PLUGIN_DATA:-}" ] && [ -x "$PLUGIN_DATA/runtime/VideoScribe.app/Contents/MacOS/VideoScribeAgent" ]; then
    app_path="$PLUGIN_DATA/runtime/VideoScribe.app"
  elif [ -x "$plugin_dir/runtime/VideoScribe.app/Contents/MacOS/VideoScribeAgent" ]; then
    app_path="$plugin_dir/runtime/VideoScribe.app"
  elif [ -x /Applications/VideoScribe.app/Contents/MacOS/VideoScribeAgent ]; then
    app_path=/Applications/VideoScribe.app
  elif [ -n "${HOME:-}" ] && [ -x "$HOME/Applications/VideoScribe.app/Contents/MacOS/VideoScribeAgent" ]; then
    app_path="$HOME/Applications/VideoScribe.app"
  fi
fi
if [ -z "$app_path" ] || [ ! -x "$app_path/Contents/MacOS/VideoScribeAgent" ]; then
  printf 'VideoScribe runtime missing. Install VideoScribe.app or run: python3 "%s/scripts/prepare-runtime.py"\n' "$plugin_dir" >&2
  exit 1
fi
export VIDEOSCRIBE_RESOURCES="$app_path/Contents/Resources"
exec "$app_path/Contents/MacOS/VideoScribeAgent" mcp "$@"
